# .env.local — LOCAL DEVELOPMENT ONLY
# This file is git-ignored and should NEVER be committed
# Use this for sensitive local-development-only secrets

# Supabase Service Role Key (NEVER expose publicly)
# Only needed for local server operations (admin tasks, migrations)
# Get this from: https://app.supabase.com/project/[PROJECT_ID]/settings/api
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Example for testing admin operations locally:
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here
