# Supabase Configuration
# Copy these from your Supabase project settings (https://app.supabase.com)
# Public keys are safe to expose (used in browser and git)

SUPABASE_PROJECT_ID=your_project_id_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_URL=https://your_project_id.supabase.co
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
VITE_SUPABASE_URL=https://your_project_id.supabase.co

# Email Service (Resend)
# Get API key from: https://resend.com/api-keys
# This key MUST be kept secret (never commit, never expose in frontend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Email Configuration
# SMTP_FROM_EMAIL: sender address (must be verified in Resend dashboard)
# ADMIN_EMAIL: where to send form submission notifications
SMTP_FROM_EMAIL=noreply@operantscale.com
ADMIN_EMAIL=wajeeh@operantscale.com

# reCAPTCHA v3 Configuration (Phase 3)
# Get keys from: https://www.google.com/recaptcha/admin
# Site Key (public, safe to expose in browser): Used for verification on frontend
VITE_RECAPTCHA_SITE_KEY=your_site_key_here

# Secret Key (private, server-only): Used for verification on backend
# MUST be kept secret - never commit to git, never expose to frontend
RECAPTCHA_SECRET_KEY=your_secret_key_here

# Deployment Configuration (Phase 3)
# To be configured when deploying to production
# VERCEL_ENV=production
# VERCEL_URL=https://operantscale.com
